@article{Thomas2019,
  title    = {Black Hole \textendash{} {{Galaxy}} Correlations in Simba},
  author   = {Thomas, Nicole and Dav{\'e}, Romeel and {Angl{\'e}s-Alc{\'a}zar}, Daniel and Jarvis, Matt},
  year     = {2019},
