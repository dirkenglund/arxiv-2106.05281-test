  journal  = {MNRAS},
  language = {en},
  number   = {4}
}

@article{Tollet2019,
  title      = {{{NIHAO XIX}}: How Supernova Feedback Shapes the Galaxy Baryon Cycle},
  shorttitle = {{{NIHAO XIX}}},
  author     = {Tollet, {\'E}douard and Cattaneo, Andrea and Macci{\`o}, Andrea V and Dutton, Aaron A and Kang, Xi},
  year       = {2019},
  month      = may,
  volume     = {485},
  pages      = {2511--2531},
  issn       = {0035-8711, 1365-2966},
  doi        = {10.1093/mnras/stz545},
  abstract   = {We have used the NIHAO (Numerical Investigation of a Hundred Astrophysical Objects) simulations to explore how supernovae (SNe) affect star formation in galaxies. We find that SN feedback operates on all scales from the interstellar medium (ISM) to several virial radii. SNe regulate star formation by preventing condensation of HI into H2 and by moving cold neutral gas to the hot HII phase. The first effect explains why the cold neutral gas in dwarf galaxies forms stars inefficiently. The second maintains the hot ISM of massive galaxies (HII vents out at lower masses). At vvir {$\sim>$} 67 km s-1, the outflow rate follows the relation: M\textperiodcentered{} out = 23 (vvir/67 km s-1)-4.6 SFR. 20 per cent\textendash 70 per cent of the gas expelled from galaxies escapes from the halo (ejective feedback) but outflows are dominated by cold swept-up gas, most of which falls back on to the galaxy on a {$\sim$}1 Gyr time-scale. This `fountain feedback' reduces the masses of galaxies by a factor of 2\textendash 4, since gas spends half to three quarter of its time in the fountain. Less than 10 per cent of the ejected gas mixes with the hot circumgalactic medium and this gas is usually not reaccreted. On scales as large as 6rvir, galactic winds divert the incoming gas from cosmic filaments and prevent it from accreting on to galaxies (preemptive feedback). This process is the main reason for the low baryon content of ultradwarves.},
  file       = {/Users/mphf18/Zotero/storage/58MWNGBK/Tollet et al. - 2019 - NIHAO XIX how supernova feedback shapes the galax.pdf},
  journal    = {MNRAS},
  language   = {en},
  number     = {2}
}

@article{Trayford2015,
  title    = {Colours and Luminosities of {\emph{z}} = 0.1 Galaxies in the Eagle Simulation},
  author   = {Trayford, James W. and Theuns, Tom and Bower, Richard G. and Schaye, Joop and Furlong, Michelle and Schaller, Matthieu and Frenk, Carlos S. and Crain, Robert A. and Vecchia, Claudio Dalla and McCarthy, Ian G.},
