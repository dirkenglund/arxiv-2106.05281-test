}

@article{Teklu2015,
  title      = {{{CONNECTING ANGULAR MOMENTUM AND GALACTIC DYNAMICS}}: {{THE COMPLEX INTERPLAY BETWEEN SPIN}}, {{MASS}}, {{AND MORPHOLOGY}}},
  shorttitle = {{{CONNECTING ANGULAR MOMENTUM AND GALACTIC DYNAMICS}}},
  author     = {Teklu, Adelheid F. and Remus, Rhea-Silvia and Dolag, Klaus and Beck, Alexander M. and Burkert, Andreas and Schmidt, Andreas S. and Schulze, Felix and Steinborn, Lisa K.},
