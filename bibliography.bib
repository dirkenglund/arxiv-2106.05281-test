@article{Cabezon2017,
  title      = {{{SPHYNX}}: An Accurate Density-Based {{SPH}} Method for Astrophysical Applications},
  shorttitle = {{{SPHYNX}}},
  author     = {Cabez{\'o}n, R. M. and {Garc{\'i}a-Senz}, D. and Figueira, J.},
  year       = {2017},
