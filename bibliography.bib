@article{Koepferl2017,
  title    = {Insights from {{Synthetic Star}}-Forming {{Regions}}. {{I}}. {{Reliable Mock Observations}} from {{SPH Simulations}}},
  author   = {Koepferl, Christine M. and Robitaille, Thomas P. and Dale, James E. and Biscani, Francesco},
  year     = {2017},
