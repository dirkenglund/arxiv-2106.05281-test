@article{Pillepich2018,
  title    = {Simulating Galaxy Formation with the {{IllustrisTNG}} Model},
  author   = {Pillepich, Annalisa and Springel, Volker and Nelson, Dylan and Genel, Shy and Naiman, Jill and Pakmor, R{\"u}diger and Hernquist, Lars and Torrey, Paul and Vogelsberger, Mark and Weinberger, Rainer and Marinacci, Federico},
  year     = {2018},
