@article{White2015,
  title    = {A {{PARAMETRIC STUDY OF POSSIBLE SOLUTIONS TO THE HIGH}}-{{REDSHIFT OVERPRODUCTION OF STARS IN MODELED DWARF GALAXIES}}},
