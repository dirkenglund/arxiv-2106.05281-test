  keywords      = {Astrophysics - Astrophysics of Galaxies,Astrophysics - Instrumentation and Methods for Astrophysics},
  language      = {en},
  primaryclass  = {astro-ph}
}

@article{Bower2017,
  title      = {The Dark Nemesis of Galaxy Formation: Why Hot Haloes Trigger Black Hole Growth and Bring Star Formation to an End},
  shorttitle = {The Dark Nemesis of Galaxy Formation},
  author     = {Bower, Richard G. and Schaye, Joop and Frenk, Carlos S. and Theuns, Tom and Schaller, Matthieu and Crain, Robert A. and McAlpine, Stuart},
  year       = {2017},
  month      = feb,
  volume     = {465},
  pages      = {32--44},
  issn       = {0035-8711, 1365-2966},
  doi        = {10.1093/mnras/stw2735},
  abstract   = {Galaxies fall into two clearly distinct types: `blue-sequence' galaxies which are rapidly forming young stars, and `red-sequence' galaxies in which star formation has almost completely ceased. Most galaxies more massive than 3 \texttimes{} 1010 M follow the red sequence, while less massive central galaxies lie on the blue sequence. We show that these sequences are created by a competition between star formation-driven outflows and gas accretion on to the supermassive black hole at the galaxy's centre. We develop a simple analytic model for this interaction. In galaxies less massive than 3 \texttimes{} 1010 M , young stars and supernovae drive a high-entropy outflow which is more buoyant than any tenuous corona. The outflow balances the rate of gas inflow, preventing high gas densities building up in the central regions. More massive galaxies, however, are surrounded by an increasingly hot corona. Above a halo mass of {$\sim$}1012 M , the outflow ceases to be buoyant and star formation is unable to prevent the build-up of gas in the central regions. This triggers a strongly non-linear response from the black hole. Its accretion rate rises rapidly, heating the galaxy's corona, disrupting the incoming supply of cool gas and starving the galaxy of the fuel for star formation. The host galaxy makes a transition to the red sequence, and further growth predominantly occurs through galaxy mergers. We show that the analytic model provides a good description of galaxy evolution in the EAGLE hydrodynamic simulations. So long as star formation-driven outflows are present, the transition mass scale is almost independent of subgrid parameter choice.},
  file       = {/Users/mphf18/Zotero/storage/K6PYXQWK/Bower et al. - 2017 - The dark nemesis of galaxy formation why hot halo.pdf},
  journal    = {MNRAS},
  language   = {en},
  number     = {1}
}

